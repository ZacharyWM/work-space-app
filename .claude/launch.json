{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "client:dev"],
      "port": 5173
    },
    {
      "name": "client-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "client"],
      "port": 5174,
      "autoPort": true
    },
    {
      "name": "client-dist",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["exec", "-w", "client", "--", "vite", "preview", "--port", "4173"],
      "port": 4173
    },
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "server:dev"],
      "port": 3000,
      "autoPort": true
    }
  ]
}
