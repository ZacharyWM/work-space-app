{
  "name": "work-space-app",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "client",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run server:dev\" \"npm run dev -w client\"",
    "client:dev": "npm run dev -w client",
    "server:dev": "cd server && go run .",
    "server:test": "cd server && go test ./...",
    "kill": "pkill -f \"work-space-app/node_modules\"; lsof -t -i tcp:3000 -i tcp:5173 -i tcp:5174 | xargs kill 2>/dev/null",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  }
}